# ==========================================
# STANDART VA METROLOGIYA BOT SOZLAMALARI
# ==========================================

# Telegram BotFather dan olingan bot tokeni
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Adminlarning Telegram ID raqamlari (vergul bilan ajratilgan)
# ID ni bilish uchun Telegramda @userinfobot ga yozing
ADMIN_IDS=123456789,987654321

# ==========================================
# SUN'IY INTELLEKT (AI) SOZLAMALARI
# ==========================================
# Provayder: 'auto', 'gemini', 'openai', yoki 'deepseek'
AI_PROVIDER=auto

# Google Gemini API Kaliti (Tavsiya etiladi - bepul va tezkor: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Kaliti (https://platform.openai.com/)
OPENAI_API_KEY=

# DeepSeek API Kaliti (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Maxsus model nomi (Ixtiyoriy: gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini, deepseek-chat)
AI_MODEL=

# ==========================================
# KOMPANIYA MA'LUMOTLARI
# ==========================================
COMPANY_NAME=O'zbekiston Standartlashtirish va Metrologiya Markazi
COMPANY_PHONE=+998 71 200 00 00
COMPANY_EMAIL=info@metrologiya.uz
COMPANY_WEBSITE=https://metrologiya.uz
COMPANY_ADDRESS=Toshkent shahri, Chilonzor tumani, Farhod ko'chasi, 1-uy
COMPANY_WORK_HOURS=Dushanba - Juma: 09:00 - 18:00 (Shanba: 09:00 - 14:00)
COMPANY_TELEGRAM_SUPPORT=@metrologiya_support

# Lokatsiya koordinatalari (Xaritada yuborish uchun)
COMPANY_LATITUDE=41.2858
COMPANY_LONGITUDE=69.2036

# Ma'lumotlar bazasi fayli
DATABASE_PATH=metrologiya.db
